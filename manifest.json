{
  "schemaVersion": 1,
  "id": "brightwalker25.minimize",
  "name": "Minimized windows",
  "version": "1.0.1",
  "author": "brightwalker25",
  "description": "Shelf of minimized windows; icon only until hovered",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Minimize.qml"
  },
  "barWidget": {
    "displayName": "Minimized windows",
    "description": "Windows stashed with SUPER + M, restored with a click",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "maxLabelWidth": 180,
      "alwaysShowLabels": false
    },
    "schema": [
      {
        "key": "maxLabelWidth",
        "type": "int",
        "label": "Max title width"
      },
      {
        "key": "alwaysShowLabels",
        "type": "bool",
        "label": "Always show titles"
      }
    ]
  }
}
