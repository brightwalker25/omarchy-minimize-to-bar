#!/usr/bin/env bash
# Keybinding handler for the brightwalker25.minimize bar widget.
#
#   minimize-toggle            SUPER + M -- minimize the focused window
#   minimize-toggle restore    SUPER + ALT + M -- pop the last one back
#
# The bare form only restores when there is nothing focused to minimize, which
# means a workspace with other windows still open will keep stashing them rather
# than undoing the last stash. "restore" is the unambiguous way back.
#
# "Most recent" comes from focusHistoryID rather than a state file we would have
# to keep in sync: minimizing a window leaves it at the front of the focus
# history, so the lowest id among the stashed windows is the last one stashed.
set -euo pipefail

STASH="special:minimized"

dispatch() { hyprctl dispatch "$1" >/dev/null; }

# Addresses are spliced into a Lua string literal; accept only plain hex.
valid_address() { [[ $1 =~ ^0x[0-9a-fA-F]+$ ]]; }

restore() {
  local last
  last=$(hyprctl -j clients | jq -r --arg ws "$STASH" '
    [ .[] | select(.workspace.name == $ws) ] | min_by(.focusHistoryID) | .address // ""')

  [[ -n $last && $last != "null" ]] || return 0
  valid_address "$last" || return 0

  # "+0" is the current workspace, so it comes back where the user is now.
  dispatch "hl.dsp.window.move({ window = \"address:$last\", workspace = \"+0\" })"
  dispatch "hl.dsp.focus({ window = \"address:$last\" })"
}

case ${1:-toggle} in
  restore)
    restore
    exit 0
    ;;
  toggle) ;;
  *)
    echo "usage: ${0##*/} [toggle|restore]" >&2
    exit 2
    ;;
esac

active=$(hyprctl -j activewindow)
focused=$(jq -r '.address // ""' <<<"$active")
workspace=$(jq -r '.workspace.name // ""' <<<"$active")
[[ $focused == "null" ]] && focused=""

# Guard on the workspace too: with the stash toggled visible the focused window
# is already minimized, and minimizing it again would be a no-op that silently
# eats the keypress instead of restoring.
if [[ -n $focused && $workspace != "$STASH" ]] && valid_address "$focused"; then
  dispatch "hl.dsp.window.move({ window = \"address:$focused\", workspace = \"$STASH\", follow = false })"
  exit 0
fi

restore
